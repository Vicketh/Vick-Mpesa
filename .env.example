# Environment: development | sandbox | production
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./vick_mpesa.db
# For production: postgresql+asyncpg://user:password@host:5432/vick_mpesa

# Daraja (Safaricom M-PESA API)
# Obtain from https://developer.safaricom.co.ke
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here
DARAJA_PASSKEY=your_lipa_na_mpesa_passkey_here
DARAJA_SHORTCODE=174379

# Callback URL (must be publicly reachable by Safaricom)
# For local dev use ngrok: https://xxxx.ngrok.io
DARAJA_CALLBACK_URL=https://your-domain.com/api/v1/payments/callback
# Optional: append ?secret=... to the callback URL sent to Daraja and reject mismatches.
DARAJA_CALLBACK_SECRET=change-this-callback-secret

# Security
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
API_KEY=change-this-mobile-api-key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
